# API keys: prefer encrypted credentials (scripts/set-secret.sh NAME) over this
# file. A key set here still works, but a stored credential takes priority.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# ZAI_CODING_API_KEY=your_zai_coding_plan_key_here   # optional: GLM via the Z.ai coding plan

# Model Configuration (optional - defaults shown)
# Default model to use for requests
# "~" IDs are OpenRouter aliases that always point at a family's newest model
COUNCIL_DEFAULT_MODEL=~openai/gpt-sol-latest

# Model cache TTL in seconds (default: 1 hour)
COUNCIL_CACHE_TTL=3600

# Request timeout in milliseconds (default: 10 minutes)
COUNCIL_TIMEOUT=600000
